<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101114"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp"
        android:layoutDirection="locale">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/titleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="VPN"
                android:textColor="#F4F4F5"
                android:textSize="27sp"
                android:textStyle="bold"/>
            <Button
                android:id="@+id/settingsButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="الإعدادات"
                android:textAllCaps="false"/>
        </LinearLayout>
        <TextView
            android:id="@+id/subtitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="اتصال خاص عبر نفق مشفّر"
            android:textColor="#B6BAC3"
            android:textSize="14sp"/>
        <LinearLayout
            android:id="@+id/statusCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:padding="22dp"
            android:orientation="vertical"
            android:background="#1C1E23">
            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="غير متصل"
                android:textColor="#F4F4F5"
                android:textSize="22sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/detailText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="استورد ملف إعداد WireGuard للبدء."
                android:textColor="#B6BAC3"
                android:textSize="14sp"/>
            <TextView
                android:id="@+id/statsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="البيانات: —"
                android:textColor="#A7C7FF"
                android:textSize="13sp"/>
            <TextView
                android:id="@+id/configName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="لم يتم استيراد إعداد"
                android:textColor="#A7C7FF"
                android:textSize="13sp"/>
        </LinearLayout>
        <Button
            android:id="@+id/enrollButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="22dp"
            android:text="تسجيل جهاز جديد"
            android:textAllCaps="false"/>
        <Button
            android:id="@+id/importButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="22dp"
            android:text="استيراد ملف الإعداد (.conf)"
            android:textAllCaps="false"/>
        <Button
            android:id="@+id/connectButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:enabled="false"
            android:text="اتصال"
            android:textAllCaps="false"/>
        <Button
            android:id="@+id/disconnectButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:enabled="false"
            android:text="قطع الاتصال"
            android:textAllCaps="false"/>
        <TextView
            android:id="@+id/securityNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="لمنع تسرب الاتصال عند انقطاع النفق، فعّل دائمًا تشغيل VPN وحظر الاتصالات بدونه من إعدادات Android."
            android:textColor="#B6BAC3"
            android:textSize="13sp"/>
    </LinearLayout>
</ScrollView>
