# Copy to /etc/simplevpn/control-plane.env and replace every placeholder.
# Never commit the real file or share its values. VPN_ADMIN_KEY must be at least 32 random bytes.
WG_INTERFACE=wg0
WG_ENDPOINT=YOUR_PUBLIC_HOST_OR_IP:51820
WG_SERVER_PUBLIC_KEY=REPLACE_WITH_SERVER_WIREGUARD_PUBLIC_KEY
VPN_NETWORK=10.77.0.0/24
VPN_GATEWAY=10.77.0.1
VPN_DNS=10.77.0.1
VPN_DB_PATH=/var/lib/simplevpn/control.db
VPN_ADMIN_KEY=REPLACE_WITH_A_LONG_RANDOM_ADMIN_SECRET
WG_BIN=/usr/bin/wg
